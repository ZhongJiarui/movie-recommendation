# 对话助手的大模型配置（可选）
# 复制本文件为 .env 后填写。不填也能用，助手会走本地引擎。
# 大模型只负责理解提问和生成回复，电影始终由本地推荐引擎检索。

LLM_PROVIDER=zhipu
LLM_API_KEY=这里填你的智谱APIKey
# 留空用服务商默认免费模型；报模型不存在时手动指定，例如 glm-4-flash
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT=6

# 智谱 key 在 https://open.bigmodel.cn 注册后，控制台 → API Keys 里拿。
# 其他可选服务商：deepseek / qwen / moonshot / openai

# 本地跑（不联网、不花钱，需先 ollama pull qwen3.5:4b）：
#   LLM_PROVIDER=custom
#   LLM_API_KEY=ollama
#   LLM_MODEL=qwen3.5:4b
#   LLM_BASE_URL=http://localhost:11434/v1

# 改完 .env 要重启服务才生效。跑 verify_llm.py 可以检查是否接通。
